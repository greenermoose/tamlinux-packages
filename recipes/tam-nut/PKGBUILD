build() {
  local flags="$CFLAGS -ffile-prefix-map=$srcdir=."
  make -C "$srcdir/libtam" core CFLAGS="$flags"
  make -C "$srcdir/libtam" install-core PREFIX="$srcdir/bootstrap-libtam"
  make -C "$srcdir/tamlinux-tools" bin/tam-bundle CFLAGS="$flags" \
    LIBTAM_PREFIX="$srcdir/bootstrap-libtam"
}

check() {
  "$srcdir/tamlinux-tools/bin/tam-bundle" --version | grep -Fx "tam-bundle $pkgver (record format 2)"
  local headers
  headers=$(readelf -lW "$srcdir/tamlinux-tools/bin/tam-bundle")
  [[ $headers != *INTERP* ]]
  for helper in apply-prepared system-units-reload user-units-reload hi start guard-removal; do
    bash -n "$srcdir/$helper"
  done
  /usr/bin/python3 -B "$srcdir/test_bootstrap.py"
}

package() {
  make -C "$srcdir/tamlinux-tools" install-bundle PREFIX=/usr DESTDIR="$pkgdir" \
    LIBTAM_PREFIX="$srcdir/bootstrap-libtam"
  make -C "$srcdir/tamlinux/commands/tam-nut" install PREFIX=/usr DESTDIR="$pkgdir"
  cd "$srcdir"
  install -Dm755 -t "$pkgdir/usr/bin" hi start
  install -Dm755 -t "$pkgdir/usr/lib/tam-nut" \
    apply-prepared system-units-reload user-units-reload guard-removal
  install -Dm644 rootstock-id "$pkgdir/usr/share/tamlinux/rootstock/id"
  install -Dm644 rootstock-profile "$pkgdir/usr/share/tamlinux/rootstock/profile"
  install -Dm644 tam-nut.1 "$pkgdir/usr/share/man/man1/tam-nut.1"
  install -Dm644 -t "$pkgdir/usr/share/polkit-1/actions" org.tamlinux.bundle.apply.policy
  install -Dm644 -t "$pkgdir/usr/share/polkit-1/rules.d" 49-tam-nut-apply.rules
  install -Dm644 -t "$pkgdir/usr/share/libalpm/hooks" \
    70-tam-nut-guard-removal.hook 95-tam-nut-check-runtime.hook
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" tam-bundle-apply.service
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants" \
    "$pkgdir/usr/lib/tamlinux" "$pkgdir/var/lib/tamlinux"
  ln -s ../tam-bundle-apply.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/tam-bundle-apply.service"
}
