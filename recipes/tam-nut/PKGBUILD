# Arch bootstrap for the format-2 workstation bundle.
pkgname=tam-nut
pkgver=0.13.0
pkgrel=1
pkgdesc='Tamlinux workstation bundle bootstrap for Arch Linux'
arch=(x86_64)
url='https://github.com/greenermoose/tamlinux'
license=(GPL-3.0-or-later)
depends=(polkit)
makedepends=(git)
checkdepends=(python)
conflicts=(tamlinux-native)
options=(!debug)

_libtam=37c0dbd2194981e23215a7edad1575fa10bdfb1e
_tools=3096a17a3775c8248b192fa2e488109ecdee61e9
_product=facb1495c3217d615c5d3ced6e172d638c35140a
source=(
  "libtam::git+https://github.com/greenermoose/libtam.git#commit=$_libtam"
  "tamlinux-tools::git+https://github.com/greenermoose/tamlinux-tools.git#commit=$_tools"
  "tamlinux::git+https://github.com/greenermoose/tamlinux.git#commit=$_product"
  rootstock-id rootstock-profile tam-bundle-apply.service
  org.tamlinux.bundle.apply.policy 49-tam-nut-apply.rules
  apply-prepared system-units-reload user-units-reload hi start tam-nut.1
  70-tam-nut-guard-removal.hook 95-tam-nut-check-runtime.hook guard-removal
  test_bootstrap.py
)
