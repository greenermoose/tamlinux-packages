format 1
component tam
build make
make-vars LIBTAM_PREFIX=@libtam@ BUNDLE_ROOT=/usr/lib/tamlinux/current DOCDIR=/usr/share/doc DATADIR=/usr/lib/tamlinux/current/share/tamlinux/knowledge
after-build libtam
build-needs ncurses
build-needs python
build-needs zlib
# Native documentation importer and generated Info directory.
build-needs libarchive
build-needs texinfo
install-targets install install-tldr
